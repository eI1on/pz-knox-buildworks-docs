---
const links = [
  {
    label: 'Steam Workshop',
    href: 'https://steamcommunity.com/profiles/76561199033892043/myworkshopfiles/?appid=108600',
    icon: 'M4 16.5a3.5 3.5 0 1 0 3.1 1.9l4.3 2.1a4.5 4.5 0 1 0 2-3.8l-4.2-2.1A3.5 3.5 0 0 0 4 16.5Zm10-7a3 3 0 1 1 6 0 3 3 0 0 1-6 0ZM6.9 17.8a1.8 1.8 0 1 1 .8-2.4l4.7 2.3a4.5 4.5 0 0 0-.3 1.6L7.7 17.2',
  },
  {
    label: 'Support on Ko-fi',
    href: 'https://ko-fi.com/ely0n',
    icon: 'M4 7h13v7.5A4.5 4.5 0 0 1 12.5 19h-4A4.5 4.5 0 0 1 4 14.5V7Zm13 2h1.5a2.5 2.5 0 0 1 0 5H17M7.5 10.5c1-1.7 3.5-1.1 3.5.7 0-1.8 2.5-2.4 3.5-.7.9 1.5-1.3 3.2-3.5 4.5-2.2-1.3-4.4-3-3.5-4.5Z',
  },
];
---

<nav class="community-links" aria-label="Knox Buildworks community links">
  {links.map((link) => (
    <a href={link.href} target="_blank" rel="noreferrer" title={link.label}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={link.icon}></path></svg>
      <span>{link.label}</span>
    </a>
  ))}
</nav>

<style>
  .community-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 2rem;
    padding: 0 0.55rem;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover {
    border-color: var(--kbw-line-soft);
    background: var(--kbw-surface-raised);
    color: var(--sl-color-white);
  }

  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 68rem) {
    a span { display: none; }
    a { width: 2rem; justify-content: center; padding: 0; }
  }

  @media (max-width: 50rem) {
    .community-links { gap: 0.5rem; }
    a span { display: inline; }
    a { width: auto; padding-inline: 0.55rem; }
  }
</style>
