---
import BlueprintScene from './BlueprintScene.astro';
import KbwIcon from './KbwIcon.astro';

interface Action {
  text: string;
  href: string;
  variant?: 'primary' | 'secondary';
}

interface Props {
  kicker: string;
  title: string;
  tagline: string;
  actions: Action[];
  meta?: string[];
}

const { kicker, title, tagline, actions, meta = [] } = Astro.props;
---

<section class="kbw-hero not-content">
  <div class="kbw-hero-copy">
    <p class="kbw-kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="kbw-tagline">{tagline}</p>

    <div class="kbw-actions">
      {
        actions.map((action) => (
          <a
            class:list={['kbw-button', action.variant === 'secondary' ? 'secondary' : 'primary']}
            href={action.href}
          >
            {action.text}
            <KbwIcon name="arrow" size="1.05em" />
          </a>
        ))
      }
    </div>

    {
      meta.length > 0 && (
        <ul class="kbw-meta">
          {meta.map((item, index) => (
            <li>
              <span class="kbw-meta-index">0{index + 1}</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="kbw-hero-art-shell">
    <div class="kbw-art-toolbar" aria-hidden="true">
      <span class="kbw-window-dots"><i></i><i></i><i></i></span>
      <span class="kbw-art-title">Blueprint workspace</span>
      <span class="kbw-art-state"><i></i> Active plan</span>
    </div>
    <div class="kbw-hero-art">
      <BlueprintScene />
    </div>
    <div class="kbw-art-legend" aria-hidden="true">
      <span><i class="built"></i> Built</span>
      <span><i class="ghost"></i> Ghost plan</span>
      <span><i class="gather"></i> Gather area</span>
    </div>
  </div>
</section>

<style>
  .kbw-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(20rem, 0.94fr) minmax(29rem, 1.06fr);
    gap: clamp(2.25rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3.5rem);
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
  }

  h1 {
    max-width: 12ch;
    margin-top: 1.1rem;
    font-size: clamp(2.75rem, 4.8vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .kbw-tagline {
    max-width: 37rem;
    margin-top: 1.25rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.68;
    color: var(--sl-color-gray-2);
  }

  .kbw-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.9rem;
  }

  .kbw-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.9rem;
    padding: 0.72rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    font-size: var(--sl-text-sm);
    font-weight: 650;
    text-decoration: none;
  }

  .kbw-button.primary {
    background: var(--kbw-accent);
    color: var(--sl-color-black);
    box-shadow: none;
  }

  .kbw-button.primary:hover { background: var(--kbw-accent-bright); }

  .kbw-button.secondary {
    border-color: var(--sl-color-gray-5);
    color: var(--sl-color-white);
    background: color-mix(in srgb, var(--kbw-surface) 82%, transparent);
  }

  .kbw-button.secondary:hover {
    border-color: var(--kbw-gold);
    color: var(--kbw-gold-bright);
  }

  .kbw-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 1.7rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--kbw-line-soft);
    list-style: none;
  }

  .kbw-meta li {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
    padding: 0 0.85rem;
    border: 0;
    border-right: 1px solid var(--kbw-line-soft);
    background: transparent;
    font-size: var(--sl-text-xs);
    line-height: 1.35;
    color: var(--sl-color-gray-2);
  }

  .kbw-meta li:first-child { padding-left: 0; }
  .kbw-meta li:last-child { border-right: 0; }

  .kbw-meta-index {
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    letter-spacing: 0;
    color: var(--kbw-gold-dim);
  }

  .kbw-hero-art-shell {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--kbw-accent) 32%, var(--sl-color-gray-5));
    border-radius: 0.5rem;
    background: var(--kbw-surface);
    box-shadow: none;
    overflow: hidden;
  }

  .kbw-art-toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 2.7rem;
    padding: 0 0.85rem;
    border-bottom: 1px solid var(--kbw-line-soft);
    background: color-mix(in srgb, var(--kbw-surface-raised) 82%, transparent);
    font-family: var(--sl-font-mono);
    font-size: 0.63rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--sl-color-gray-3);
  }

  .kbw-window-dots { display: flex; gap: 0.3rem; }

  .kbw-window-dots i {
    width: 0.4rem;
    height: 0.4rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 50%;
  }

  .kbw-art-state {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--kbw-green);
  }

  .kbw-art-state i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  .kbw-hero-art {
    background:
      linear-gradient(var(--kbw-grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--kbw-grid-line) 1px, transparent 1px),
      var(--kbw-surface);
    background-size: 28px 28px, 28px 28px, auto;
    padding: clamp(0.4rem, 1.2vw, 1rem);
  }

  .kbw-art-legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.3rem;
    padding: 0.75rem 1rem 0.85rem;
    border-top: 1px solid var(--kbw-line-soft);
    background: color-mix(in srgb, var(--kbw-surface-raised) 62%, transparent);
    font-family: var(--sl-font-mono);
    font-size: 0.63rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--sl-color-gray-3);
  }

  .kbw-art-legend span { display: inline-flex; align-items: center; gap: 0.4rem; }

  .kbw-art-legend i {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid currentColor;
    background: currentColor;
    opacity: 0.8;
  }

  .kbw-art-legend .built { color: var(--kbw-gold); }
  .kbw-art-legend .ghost { color: var(--sl-color-gray-2); background: transparent; }
  .kbw-art-legend .gather { color: var(--kbw-green); }

  @media (prefers-reduced-motion: no-preference) {
    .kbw-button { transition: background 140ms ease, border-color 140ms ease, color 140ms ease; }
    .kbw-button :global(svg) { transition: translate 140ms ease; }
    .kbw-button:hover :global(svg) { translate: 3px 0; }
  }

  @media (max-width: 56rem) {
    .kbw-hero { grid-template-columns: 1fr; }
    .kbw-hero-art-shell { order: 2; max-width: 40rem; }
  }

  @media (max-width: 34rem) {
    .kbw-meta { grid-template-columns: 1fr; }
    .kbw-art-toolbar { grid-template-columns: 1fr 1fr; }
    .kbw-art-title { display: none; }
  }
</style>
