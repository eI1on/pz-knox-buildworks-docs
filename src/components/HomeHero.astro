---
import BlueprintScene from './BlueprintScene.astro';
import KbwIcon from './KbwIcon.astro';

interface Action {
  text: string;
  href: string;
  variant?: 'primary' | 'secondary';
}

interface Props {
  kicker: string;
  title: string;
  tagline: string;
  actions: Action[];
}

const { kicker, title, tagline, actions } = Astro.props;
---

<section class="kbw-hero not-content">
  <div class="kbw-hero-copy">
    <p class="kbw-kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="kbw-tagline">{tagline}</p>

    <div class="kbw-actions">
      {
        actions.map((action) => (
          <a
            class:list={['kbw-button', action.variant === 'secondary' ? 'secondary' : 'primary']}
            href={action.href}
          >
            {action.text}
            <KbwIcon name="arrow" size="1.05em" />
          </a>
        ))
      }
    </div>

  </div>

  <figure class="kbw-hero-art-shell">
    <div class="kbw-hero-art">
      <BlueprintScene />
    </div>
    <figcaption>Built walls, planned floors, and a supply area in one layout.</figcaption>
  </figure>
</section>

<style>
  .kbw-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(19rem, 0.9fr) minmax(25rem, 1.1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3rem);
    isolation: isolate;
    overflow: hidden;
    overflow: clip;
  }

  h1 {
    max-width: 13ch;
    margin-top: 1.1rem;
    font-size: clamp(2.45rem, 4vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .kbw-tagline {
    max-width: 37rem;
    margin-top: 1.25rem;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.68;
    color: var(--sl-color-gray-2);
  }

  .kbw-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.9rem;
  }

  .kbw-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.9rem;
    padding: 0.72rem 1.25rem;
    border: 0;
    border-radius: 0.25rem;
    font-size: var(--sl-text-sm);
    font-weight: 650;
    text-decoration: none;
  }

  .kbw-button.primary {
    background: var(--kbw-accent);
    color: #191a16;
    box-shadow: none;
  }

  .kbw-button.primary:hover { background: var(--kbw-accent-bright); }

  .kbw-button.secondary {
    color: var(--sl-color-white);
    background: var(--kbw-surface-raised);
  }

  .kbw-button.secondary:hover {
    color: var(--kbw-accent-bright);
    background: color-mix(in srgb, var(--kbw-accent) 12%, var(--kbw-surface-raised));
  }

  .kbw-hero-art-shell {
    position: relative;
    margin: 0;
    border-radius: 0.25rem;
    background: var(--kbw-surface);
    box-shadow: none;
    overflow: hidden;
  }

  .kbw-hero-art {
    padding: clamp(0.6rem, 1.2vw, 1rem);
  }

  figcaption {
    padding: 0 1rem 0.9rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .kbw-button { transition: background 140ms ease, color 140ms ease; }
  }

  @media (max-width: 56rem) {
    .kbw-hero { grid-template-columns: 1fr; }
    .kbw-hero-art-shell { order: 2; max-width: 40rem; }
  }

</style>
