---
import KbwIcon from './KbwIcon.astro';
import type { ComponentProps } from 'astro/types';

interface QuickLink {
  text: string;
  href: string;
}

interface Props {
  title: string;
  icon: ComponentProps<typeof KbwIcon>['name'];
  href?: string;
  cta?: string;
  links?: QuickLink[];
  wide?: boolean;
}

const { title, icon, href, cta = 'Open guide', links, wide = false } = Astro.props;
---

<article class:list={['kbw-card', { 'is-link': !!href, wide }]}>
  <div class="kbw-card-head">
    <span class="kbw-card-icon"><KbwIcon name={icon} size="1.35rem" /></span>
    <h3 class="kbw-card-title">
      {href ? <a href={href}>{title}</a> : title}
    </h3>
  </div>
  <div class="kbw-card-body"><slot /></div>
  {
    links && links.length > 0 && (
      <ul class="kbw-card-links">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.text}</a>
          </li>
        ))}
      </ul>
    )
  }
  {
    href && (
      <p class="kbw-card-cta" aria-hidden="true">
        {cta}
        <KbwIcon name="arrow" size="0.95em" />
      </p>
    )
  }
</article>

<style>
  .kbw-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem 1.4rem 1.4rem;
    border: 0;
    border-radius: 0.25rem;
    background: var(--kbw-surface);
    box-shadow: none;
    overflow: hidden;
  }

  .kbw-card.is-link:hover {
    background: var(--kbw-surface-raised);
  }

  .kbw-card.wide {
    grid-column: span 2;
    background: var(--kbw-surface);
  }

  @media (max-width: 56rem) {
    .kbw-card.wide {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .kbw-card {
      transition: background-color 160ms ease;
    }
  }

  .kbw-card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .kbw-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border: 0;
    background: transparent;
    color: var(--kbw-accent-bright);
  }

  .kbw-card-title {
    margin: 0;
    font-size: var(--sl-text-lg);
    line-height: 1.25;
    color: var(--sl-color-white);
  }

  .kbw-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .kbw-card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .kbw-card-body {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }

  .kbw-card-body :global(p) {
    margin: 0;
  }

  .kbw-card-links {
    margin: 0;
    padding: 0.15rem 0 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--sl-text-sm);
  }

  .kbw-card-links li {
    padding-inline-start: 0;
  }

  .kbw-card-links a {
    position: relative;
    z-index: 1;
    color: var(--sl-color-gray-1);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--kbw-gold) 35%, transparent);
    text-underline-offset: 0.2em;
  }

  .kbw-card-links a:hover {
    color: var(--kbw-gold-bright);
  }

  .kbw-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: auto 0 0;
    padding-top: 0.35rem;
    font-size: var(--sl-text-xs);
    font-weight: 650;
    letter-spacing: 0;
    text-transform: none;
    color: var(--kbw-gold);
  }
</style>
