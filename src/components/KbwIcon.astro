---
interface Props {
  name:
    | 'catalogue'
    | 'blueprint'
    | 'wall'
    | 'hammer'
    | 'shield'
    | 'braces'
    | 'server'
    | 'layers'
    | 'compass'
    | 'arrow';
  label?: string;
  size?: string;
}

const { name, label, size = '1em' } = Astro.props;

const paths: Record<Props['name'], string> = {
  catalogue:
    'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7zM15.5 15.5h2v2h-2z',
  blueprint:
    'M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2ZM8 7h5M8 11h8M8 15h3m3 0h2',
  wall: 'M3 14h18v6H3zM3 8h18v6H3zM9 8v6M15 8v6M6 14v6M12 14v6M18 14v6M3 8l4-4h14l-4 4',
  hammer:
    'M13.5 6 6 13.5l2.5 2.5L16 8.5M13 4.5 16.5 8M13 4.5c1.5-1.5 4-1.5 5.5 0L20 6l-3.5 2.5M9.5 14.5 5 19',
  shield:
    'M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6l-7-3ZM9 11.5l2.2 2.2L15.5 9',
  braces:
    'M9 4c-2 0-3 1-3 3v2c0 1.5-1 2.5-2.5 3C5 12.5 6 13.5 6 15v2c0 2 1 3 3 3M15 4c2 0 3 1 3 3v2c0 1.5 1 2.5 2.5 3C19 12.5 18 13.5 18 15v2c0 2-1 3-3 3',
  server:
    'M4 5h16v6H4zM4 13h16v6H4zM7 8h.01M7 16h.01M13 8h4M13 16h4',
  layers: 'm12 3 9 5-9 5-9-5 9-5ZM3 13l9 5 9-5M12 8v0',
  compass:
    'M12 3v3m0 0a2 2 0 0 1 2 2c0 .8-.4 1.4-1 1.8L17 20m-5-11.2c-.6-.4-1-1-1-1.8a2 2 0 0 1 2-2ZM11 9.8 7 20m2.5-4h5',
  arrow: 'M5 12h14m-6-6 6 6-6 6'
};
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  <path d={paths[name]}></path>
</svg>
