---
import GameGlyph from './GameGlyph.astro';

const cards = [
  { name: 'Advanced Forge', glyph: 'forge', fav: true, active: true },
  { name: 'Wooden Wall', glyph: 'wall' },
  { name: 'Amphora', glyph: 'amphora' },
  { name: 'Antlers Pole', glyph: 'antlers' },
  { name: 'Barbed Wire Fence', glyph: 'fence' },
  { name: 'Bed', glyph: 'bed', fav: true },
  { name: 'Big Double Pole Ga...', glyph: 'gate' },
  { name: 'Big Double Wire G...', glyph: 'gate' },
  { name: 'Big Metal Locker', glyph: 'locker' }
] as const;
---

<figure class="kbw-uimock not-content" role="img" aria-label="Annotated wireframe of the Knox Buildworks catalogue window">
  <div class="window">
    <div class="titlebar">
      <span class="title">Knox Buildworks</span>
      <span class="badge tb" data-n="1">1</span>
    </div>

    <div class="toolbar">
      <span class="control search">Search...<span class="badge" data-n="2">2</span></span>
      <span class="control">Recipe name ▾</span>
      <span class="control">Alphabetic A-Z ▾<span class="badge" data-n="3">3</span></span>
      <span class="control icon">≡</span>
      <span class="control chip active">All</span>
      <span class="control chip">☆</span>
      <span class="control chip">Recent<span class="badge" data-n="4">4</span></span>
      <span class="spacer"></span>
      <span class="control chip">Plans</span>
      <span class="control chip">v<span class="badge" data-n="5">5</span></span>
    </div>

    <div class="categories">
      <span class="control pager">‹</span>
      <span class="control pager">›</span>
      <span class="control chip active">All categories</span>
      <span class="control chip">Agricultural</span>
      <span class="control chip">Animals</span>
      <span class="badge" data-n="6">6</span>
    </div>

    <div class="filters">
      <span class="control">All types ▾</span>
      <span class="control">All materials ▾</span>
      <span class="control">All skills ▾</span>
      <span class="badge" data-n="7">7</span>
    </div>

    <div class="body">
      <div class="grid-pane">
        <span class="badge float" data-n="8">8</span>
        {
          cards.map((card) => (
            <span class:list={['card', { active: 'active' in card && card.active }]}>
              <span class="card-pins">
                <span class="pin">⚲</span>
                <span class:list={['star', { fav: 'fav' in card && card.fav }]}>★</span>
              </span>
              <span class="thumb"><GameGlyph name={card.glyph} size="1.9rem" /></span>
              <span class="card-name">{card.name}</span>
              <span class="ready">■ Ready</span>
            </span>
          ))
        }
      </div>

      <div class="inspector">
        <p class="inspector-name">Advanced Forge <span class="pin">⚲</span> <span class="star fav">★</span></p>
        <p class="desc">For the most advanced metal forging, including metal armors, blades, and tool heads.</p>
        <p class="meta">⏱ Real time taken: 5 seconds &nbsp; ☀ Requires light.</p>
        <div class="preview">
          <span class="preview-glyph"><GameGlyph name="forge" size="3.2rem" /></span>
          <span class="foot">3x3x1<span class="badge" data-n="9">9</span></span>
        </div>
        <p class="status ok">Ready to build<span class="badge" data-n="10">10</span></p>
        <p class="section">Skills &amp; knowledge</p>
        <p class="dim-line">No skill or recipe gate</p>
        <p class="section">Materials &amp; tools<span class="badge" data-n="11">11</span></p>
        <div class="req-card">
          <span class="req-icon"><GameGlyph name="trowel" size="1.5rem" /></span>
          <span class="req-main">
            <span class="req-head"><strong>Mason's Trowel</strong><span class="count">0/1</span></span>
            <span class="req-sub">Tool | kept | 2 alternatives | #MasonsTrowel | Slight chance of damaging tool.</span>
          </span>
        </div>
        <p class="actions">
          <span class="btn build">Build</span>
          <span class="btn">Place Plan</span>
          <span class="badge" data-n="12">12</span>
        </p>
      </div>

      <div class="drawer">
        <p class="drawer-head">Available Ingredients / Possible Items <span class="close">✕</span><span class="badge" data-n="13">13</span></p>
        <p class="drawer-item">Mason's Trowel</p>
        <p class="drawer-line"><GameGlyph name="hammer" size="1em" /> Recipe use: keep</p>
        <p class="drawer-section">▾ Input rules</p>
        <p class="drawer-line">Prop1</p>
        <p class="drawer-line">Slight chance of damaging tool.</p>
        <p class="drawer-section">▾ Available Ingredients</p>
        <p class="drawer-line none">None available</p>
        <p class="drawer-section">▾ Possible Items</p>
        <p class="drawer-row selected"><span class="row-icon"><GameGlyph name="trowel" size="1.2rem" /></span>Mason's Trowel<span class="qty">0</span></p>
        <p class="drawer-row"><span class="row-icon"><GameGlyph name="trowel" size="1.2rem" /></span>Wooden Trowel<span class="qty">0</span></p>
        <p class="drawer-foot">Accepted item tag: MasonsTrowel (base:masonstrowel)</p>
      </div>
    </div>
  </div>
</figure>

<style>
  .kbw-uimock {
    margin: 1.5rem 0 1rem;
    container-type: inline-size;
  }

  .window {
    border: 1px solid var(--kbw-line);
    border-radius: 0.45rem;
    background: color-mix(in srgb, #131413 94%, transparent);
    overflow: hidden;
    font-family: var(--sl-font);
    font-size: 0.7rem;
    color: var(--sl-color-gray-2);
  }

  :root[data-theme='light'] .window {
    background: var(--kbw-surface);
  }

  .titlebar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.8rem;
    background: color-mix(in srgb, var(--sl-color-black) 60%, transparent);
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .title {
    font-weight: 650;
    color: var(--sl-color-white);
    letter-spacing: 0.02em;
  }

  .badge.tb {
    position: absolute;
    right: 0.8rem;
  }

  .toolbar,
  .categories,
  .filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    position: relative;
  }

  .control {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    position: relative;
    padding: 0.22rem 0.5rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--sl-color-black) 45%, transparent);
    white-space: nowrap;
  }

  .control.search {
    min-width: 9rem;
    color: var(--sl-color-gray-3);
  }

  .control.chip.active {
    background: color-mix(in srgb, var(--sl-color-white) 88%, transparent);
    color: #17191a;
    font-weight: 600;
  }

  .control.pager {
    padding-inline: 0.4rem;
  }

  .spacer {
    flex: 1;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 0.95fr);
  }

  @container (max-width: 46rem) {
    .body {
      grid-template-columns: 1fr;
    }

    .inspector,
    .drawer {
      border-inline-start: 0 !important;
      border-top: 1px solid var(--sl-color-gray-5);
    }
  }

  .grid-pane {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    padding: 0.7rem 0.8rem;
    align-content: start;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1.1rem 0.25rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--kbw-green) 55%, transparent);
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--sl-color-black) 55%, transparent);
    text-align: center;
  }

  .card.active {
    border-color: var(--kbw-green);
    background: color-mix(in srgb, var(--kbw-green) 8%, transparent);
  }

  .card-pins {
    position: absolute;
    top: 0.25rem;
    left: 0.35rem;
    right: 0.35rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--sl-color-gray-3);
  }

  .star.fav {
    color: var(--kbw-gold);
  }

  .card .thumb {
    color: var(--sl-color-gray-1);
  }

  .card-name {
    font-size: 0.62rem;
    line-height: 1.2;
    color: var(--sl-color-white);
  }

  .ready {
    font-size: 0.6rem;
    color: var(--kbw-green);
  }

  .inspector {
    border-inline-start: 1px solid var(--sl-color-gray-5);
    padding: 0.7rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .inspector p,
  .drawer p {
    margin: 0;
    position: relative;
  }

  .inspector-name {
    font-weight: 650;
    color: var(--sl-color-white);
    font-size: 0.85rem;
  }

  .pin {
    color: var(--sl-color-gray-3);
  }

  .desc {
    color: var(--sl-color-gray-2);
    line-height: 1.45;
  }

  .meta {
    color: var(--sl-color-gray-3);
    font-size: 0.64rem;
  }

  .preview {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--sl-color-black) 55%, transparent);
    color: var(--sl-color-gray-1);
  }

  .foot {
    position: absolute;
    bottom: 0.35rem;
    right: 0.45rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--sl-font-mono);
    font-size: 0.62rem;
    color: var(--sl-color-gray-3);
  }

  .status {
    font-weight: 650;
  }

  .status.ok {
    color: var(--kbw-green);
  }

  .section {
    margin-top: 0.25rem !important;
    font-size: 0.64rem;
    font-weight: 650;
    color: var(--kbw-gold);
  }

  .dim-line {
    color: var(--sl-color-gray-3);
  }

  .req-card {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    padding: 0.45rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--sl-color-black) 45%, transparent);
  }

  .req-icon {
    color: var(--sl-color-gray-1);
    flex-shrink: 0;
  }

  .req-main {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .req-head {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--sl-color-white);
  }

  .count {
    color: var(--kbw-gold);
    font-family: var(--sl-font-mono);
  }

  .req-sub {
    color: var(--sl-color-gray-3);
    font-size: 0.62rem;
    line-height: 1.4;
  }

  .actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.3rem !important;
  }

  .btn {
    padding: 0.3rem 1rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.2rem;
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .btn.build {
    background: color-mix(in srgb, var(--kbw-green-deep) 75%, transparent);
    border-color: var(--kbw-green-deep);
  }

  .drawer {
    border-inline-start: 1px solid var(--sl-color-gray-5);
    padding: 0.7rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: color-mix(in srgb, var(--sl-color-black) 30%, transparent);
  }

  .drawer-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 650;
    color: var(--kbw-gold);
    font-size: 0.66rem;
  }

  .close {
    margin-inline-start: auto;
    color: var(--sl-color-gray-3);
  }

  .drawer-item {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .drawer-line {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-gray-2);
  }

  .drawer-line.none {
    color: var(--sl-color-gray-3);
  }

  .drawer-section {
    margin-top: 0.25rem !important;
    color: var(--kbw-gold);
    font-weight: 650;
    font-size: 0.64rem;
  }

  .drawer-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 0.2rem;
    color: var(--sl-color-gray-1);
  }

  .drawer-row.selected {
    border-color: var(--sl-color-gray-4);
    background: color-mix(in srgb, var(--sl-color-white) 8%, transparent);
    color: var(--sl-color-white);
  }

  .row-icon {
    color: var(--sl-color-gray-2);
    display: inline-flex;
  }

  .qty {
    margin-inline-start: auto;
    font-family: var(--sl-font-mono);
  }

  .drawer-foot {
    margin-top: 0.3rem !important;
    color: var(--sl-color-gray-3);
    font-size: 0.62rem;
    line-height: 1.4;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--kbw-gold);
    color: #17191a;
    font-size: 0.62rem;
    font-weight: 700;
    font-family: var(--sl-font-mono);
    flex-shrink: 0;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--sl-color-black) 60%, transparent);
  }

  .badge.float {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    z-index: 1;
  }
</style>
