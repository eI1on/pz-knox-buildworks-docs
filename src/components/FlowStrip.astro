---
import KbwIcon from './KbwIcon.astro';
import type { ComponentProps } from 'astro/types';

interface Step {
  icon: ComponentProps<typeof KbwIcon>['name'];
  title: string;
  detail: string;
}

const steps: Step[] = [
  { icon: 'braces', title: 'Define', detail: 'JSON manifests & buildables' },
  { icon: 'shield', title: 'Validate', detail: 'Schema & registry integrity' },
  { icon: 'compass', title: 'Plan', detail: 'Rooms, ghosts & blueprints' },
  { icon: 'hammer', title: 'Build', detail: 'Timed construction cursor' },
  { icon: 'server', title: 'Sync', detail: 'Server-authoritative state' }
];
---

<ol class="kbw-flow not-content">
  {
    steps.map((step, index) => (
      <li>
        <div class="kbw-flow-node">
          <span class="kbw-flow-icon"><KbwIcon name={step.icon} size="1.15rem" /></span>
        </div>
        <p class="kbw-flow-step">{String(index + 1).padStart(2, '0')}</p>
        <p class="kbw-flow-title">{step.title}</p>
        <p class="kbw-flow-detail">{step.detail}</p>
      </li>
    ))
  }
</ol>

<style>
  .kbw-flow {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.15rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    margin: 0;
    text-align: left;
  }

  .kbw-flow-node {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  li:not(:last-child) .kbw-flow-node::after {
    content: '';
    position: absolute;
    left: calc(2.4rem + 0.6rem);
    right: calc(-1rem + 0.4rem);
    top: 50%;
    height: 1px;
    background: var(--kbw-line);
    opacity: 0.4;
  }

  .kbw-flow-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 0.5rem;
    border: 1px solid var(--kbw-line);
    color: var(--kbw-accent-bright);
    background: color-mix(in srgb, var(--kbw-accent) 8%, var(--sl-color-black));
    box-shadow: none;
  }

  p {
    margin: 0;
    line-height: 1.4;
  }

  .kbw-flow-step {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0;
    color: var(--kbw-gold-dim);
  }

  .kbw-flow-title {
    margin-top: 0.1rem;
    font-size: var(--sl-text-base);
    font-weight: 650;
    color: var(--sl-color-white);
  }

  .kbw-flow-detail {
    margin-top: 0.15rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 64rem) {
    .kbw-flow {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }

    li .kbw-flow-node::after {
      display: none;
    }
  }
</style>
